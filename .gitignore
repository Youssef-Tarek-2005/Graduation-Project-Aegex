.venv/
__pycache__/
*.pyc
.pytest_cache/
dead_letter*.ndjson
data/*.csv
!data/.gitkeep

# step 9 output: generated from the database, rebuild with python -m features.dataset
data/processed/
artifacts/

# AI model runs and test recordings: generated, rebuild with python -m detect / python -m demo.make_poc_pcaps
backend/model_runs/
backend/pcaps/

# Step 3 pipeline run reports: generated, one JSON per run (python -m ingest.pipeline run ...)
backend/pipeline_runs/

# Step 4 database backups (python -m ingest.datastore backup): large, local only
backend/backups/

# Step 6 replay ground-truth files (python -m demo.replay): generated
backend/replays/

# Claude desktop app settings (local to each PC, not part of the project)
.claude/

# Task B's own Markdown docs stay local; teammates' docs (ai-models/, docs/, honeypot-poc/) and README.md stay in git
backend/**/*.md
contracts/*.md
