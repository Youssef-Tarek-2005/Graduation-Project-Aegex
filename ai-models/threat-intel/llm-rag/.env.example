# Copy to .env INSIDE the threat-intelligence-assistant folder (not here).
# Fully local profile: no API key, no cloud, nothing leaves the machine.

DEPLOYMENT_PROFILE=local
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434

# Must stay nomic-embed-text: the committed FAISS index was embedded with it.
# Another model gives the same 768 dimensions, so nothing errors — retrieval
# just quietly returns the wrong documents.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

VECTORSTORE_BACKEND=faiss
RETRIEVAL_TOP_K=5
CONFIDENCE_THRESHOLD=40
HARD_ABSTENTION_ENABLED=true
RETRIEVAL_ONLY_FALLBACK=true
LLM_REWRITE_FOLLOWUPS=true
INCLUDE_GROUPS_SOFTWARE=true
MEMORY_MAX_TURNS=3
INGEST_BATCH_SIZE=32

DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
INDICES_DIR=indices/faiss_index
