    "backdoor":          {"name": "Backdoor / unauthorized access", "labels": ["Backdoor", "backdoor", "Backdoor_Malware", "persistence", "remote access"]},
    "ransomware":        {"name": "Ransomware", "labels": ["Ransomware", "ransomware", "crypto malware", "crypto-ransomware"]},
