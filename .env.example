# Copy to .env (docker compose reads it automatically). All optional.
ZEEK_INTERFACE=eth0          # network interface Zeek sniffs on the HOST (ip a). Linux: e.g. eth0 / ens33 / docker0 / br-xxxx
# ZEEK_BPF=tcp port 2222 or tcp port 2223 or tcp port 1883
# ZEEK_IMAGE=zeek/zeek:8.0
# AEGEX_SIMULATE_NETWORK=false   # only real honeypot traffic
# AEGEX_FOLLOW_CSV=true
AEGEX_FOLLOW_CSV=true
AEGEX_SIMULATE_NETWORK=true