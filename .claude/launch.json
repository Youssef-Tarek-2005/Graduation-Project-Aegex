{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aegex-api",
      "runtimeExecutable": "backend/.venv/Scripts/python",
      "runtimeArgs": ["-m", "uvicorn", "--app-dir", "backend", "api.main:app", "--port", "8001"],
      "port": 8001
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "backend/.venv/Scripts/python",
      "runtimeArgs": ["-m", "http.server", "8095", "--bind", "127.0.0.1", "--directory", "frontend"],
      "port": 8095,
      "autoPort": false
    }
  ]
}
